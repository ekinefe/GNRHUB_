{
  // D1 config for the db:* scripts only (passed with --config).
  // The real wrangler.jsonc arrives with the Worker migration (GNR-16); a
  // wrangler.jsonc here would change how Cloudflare Pages builds this site.
  "name": "gnrdigital",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gnrdigital-prod",
      // Replace with the id printed by `wrangler d1 create gnrdigital-prod`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "preview_database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "db/migrations"
    }
  ]
}

{
  "name": "gnrdigital-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "check:links": "node scripts/check-links.mjs",
    "db:migrate:local": "node scripts/db.mjs migrate-local",
    "db:migrate:remote": "node scripts/db.mjs migrate-remote",
    "db:query:local": "node scripts/db.mjs query-local",
    "admin:secret": "node scripts/admin-secrets.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "changelog": "node scripts/changelog.mjs",
    "security:sweep": "node scripts/security-sweep.mjs",
    "dev:worker": "vite build && wrangler dev --local"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.1",
    "gsap": "^3.14.2",
    "lucide-react": "^0.475.0",
    "motion": "^12.34.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.5",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^5.3.4",
    "vitest": "^3.0.5",
    "wrangler": "^4.151.1"
  }
}

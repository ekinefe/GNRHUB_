{
  "name": "gnrdigital", // the Worker name never changes after the first deploy
  "main": "functions/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths run Worker code (the API, and the sitemap that lists blog posts); deep links like /about stay static.
    "run_worker_first": ["/api/*", "/sitemap.xml"]
  },
  // Content database (ADR 0009): contact messages and blog posts only. No database_id on purpose: the first
  // `wrangler deploy` run by the owner creates it, and `npm run db:migrate:remote` then applies the migrations.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gnrdigital",
      "migrations_dir": "db/migrations"
    }
  ]
}

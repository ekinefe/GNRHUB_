{
  "name": "gnrdigital", // the Worker name never changes after the first deploy
  "main": "functions/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these prefixes run Worker code; deep links like /about stay static.
    "run_worker_first": ["/api/*"]
  },
  // One cron trigger for every scheduled job (GNR-151); keep TRIGGER_MINUTES in cron/dispatcher.ts in sync.
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gnrdigital-prod",
      // Replace with the id printed by `wrangler d1 create gnrdigital-prod`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations"
    }
  ],

  // Preview versions (`wrangler versions upload --env preview`) bind the DEV database, so
  // unmerged code can never touch real data. Bindings and vars are not inherited by
  // environments, so everything is repeated here. No secrets in this file: use `wrangler secret`.
  "env": {
    "preview": {
      "name": "gnrdigital-preview",
      "assets": {
        "directory": "dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gnrdigital-dev",
          // Replace with the id printed by `wrangler d1 create gnrdigital-dev`.
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "db/migrations"
        }
      ]
    }
  }
}

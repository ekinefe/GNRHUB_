{
  "name": "gnrdigital", // the Worker name never changes after the first deploy
  "main": "functions/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these prefixes run Worker code; deep links like /about stay static.
    "run_worker_first": ["/api/*"]
  }
}

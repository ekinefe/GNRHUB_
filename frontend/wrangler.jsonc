{
  "name": "portfolio", // the Worker name never changes after the first deploy; must match the Cloudflare project name
  "main": "functions/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths run Worker code (the API, the sitemap and the RSS feed, both built from the blog posts, and the owner's short links /r/*); deep links like /about stay static.
    "run_worker_first": ["/api/*", "/sitemap.xml", "/blog/feed.xml", "/r/*"]
  },
  // Logs and request traces in the Cloudflare dashboard (GNR-126); the Worker writes one JSON line per request, see worker.ts.
  "observability": { "enabled": true },
  // Content database (ADR 0009): contact messages and blog posts only. No database_id on purpose: the first
  // `wrangler deploy` run by the owner creates it, and `npm run db:migrate:remote` then applies the migrations.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gnrdigital",
      "migrations_dir": "db/migrations"
    }
  ],
  // Workers Builds runs `npx wrangler preview` for every non-main branch, which needs this block (it can be empty).
  // Previews do not inherit the production D1 database or secrets, so a preview shows the pages but its API routes
  // (blog, contact) have no database. Production data is never touched from a preview.
  "previews": {}
}
